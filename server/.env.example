# RobocallGuard backend configuration
# Copy to `.env` (which is gitignored) and fill in.

PORT=3000
# Shared token — the app sends this with every request. Generate a long random one.
AUTH_TOKEN=change-me-to-a-long-random-token
# Admin dashboard + API token (dashboard at /admin). Empty = admin disabled.
ADMIN_TOKEN=change-me-to-a-different-long-token
DB_PATH=/opt/robocallguard/data/calls.db

# Lookup cache TTL in ms (default 7 days)
CACHE_TTL_MS=604800000

# Minimum reputation score to include a number in the /top-blocked feed
TOP_THRESHOLD=0.6

# Optional external carrier/line-type lookups (server works fully without them)
NUMVERIFY_KEY=
# omkarcloud/phone-lookup-api — free tier 5,000 lookups/month (carrier + VoIP line type)
OMKAR_API_KEY=
